{
  "manifest_version": 3,
  "name": "Services (DevTools)",
  "version": "3.1.0",
  "key": "",
  "description": "A DevTools \"Services\" panel: one tab bar over the shared app-shell for MySQL, REST, GraphQL, gRPC, Splunk and Terminal, talking to a native-messaging host.",
  "devtools_page": "devtools.html",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*"
  ]
}
