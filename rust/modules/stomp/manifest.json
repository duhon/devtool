{
  "id": "stomp",
  "name": "STOMP",
  "description": "Send a message to, or consume messages from, a STOMP broker such as Apache ActiveMQ Artemis. SUBSCRIBE acknowledges each returned message (Count default 10, Wait default 5 seconds without a new message).",
  "params": [
    {"name": "command", "flag": "command", "alias": "m", "positional": true, "type": "string", "required": true, "default": "SEND"},
    {"name": "url", "flag": "endpoint", "alias": "e", "positional": true, "type": "string", "required": true},
    {"name": "headers", "flag": "headers", "alias": "H", "type": "json"},
    {"name": "body", "flag": "body", "alias": "b", "type": "string"},
    {"name": "options", "flag": "options", "alias": "o", "multi": true, "type": "keyvalue", "keys": {"count": "count", "wait": "wait", "client-id": "clientId", "host": "vhost", "columns-type": "columnsType", "columns-size": "columnsSize"}},
    {"name": "count", "type": "string", "resolve": "none"},
    {"name": "wait", "type": "string", "resolve": "none"},
    {"name": "clientId", "type": "string"},
    {"name": "vhost", "type": "string"},
    {"name": "columnsType", "type": "string", "resolve": "none"},
    {"name": "columnsSize", "type": "string", "resolve": "none"}
  ],
  "console": {
    "order": 7,
    "sections": [
      {"name": "endpoint", "shape": "line", "language": "http", "param": "url", "hints": [{"text": "stomp://"}, {"text": "stomp+ssl://"}]},
      {"name": "headers", "shape": "pairs", "language": "headers", "param": "headers", "hints": [{"text": "destination-type: ANYCAST", "detail": "Artemis SEND: a queue"}, {"text": "destination-type: MULTICAST", "detail": "Artemis SEND: a topic"}, {"text": "subscription-type: ANYCAST", "detail": "Artemis SUBSCRIBE: a queue"}, {"text": "subscription-type: MULTICAST", "detail": "Artemis SUBSCRIBE: a topic"}, {"text": "content-type: application/json"}, {"text": "persistent: true"}, {"text": "durable-subscription-name: ", "detail": "with Client-Id in #options"}, {"text": "selector: "}, {"text": "expires: "}, {"text": "priority: "}]},
      {"name": "options", "shape": "block", "language": "headers", "param": "options", "hints": [{"text": "Count: 10", "detail": "SUBSCRIBE: messages to consume, 1-1000"}, {"text": "Wait: 5", "detail": "SUBSCRIBE: seconds to wait for the next message, 1-600"}, {"text": "Client-Id: "}, {"text": "Host: ", "detail": "virtual host sent in CONNECT"}, {"text": "Columns-Type: ", "detail": "column=json column=datetime column=number column=boolean column=text"}, {"text": "Columns-Size: ", "detail": "column=100 (characters)"}]},
      {"name": "body", "shape": "block", "language": "json", "param": "body"}
    ],
    "payload": "body",
    "response": "grid",
    "keywords": ["SEND", "SUBSCRIBE"],
    "hints": "#endpoint\nstomp://\nstomp+ssl://\n\n#headers\ndestination-type: ANYCAST\nsubscription-type: ANYCAST\ncontent-type: application/json\n",
    "timeout": 620
  }
}
